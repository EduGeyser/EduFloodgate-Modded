      <scope>compile</scope>
    </dependency>
    <dependency>
      <groupId>com.nukkitx.fastutil</groupId>
      <artifactId>fastutil-int-object-maps</artifactId>
      <version>8.5.3</version>
      <scope>compile</scope>
